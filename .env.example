# Copy to .env.local and adjust. Never commit real secrets.
# Variables are added in the phase that first needs them (docs/PLANNING.md, Appendix A).

# Public base URL of the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Uploads allowed per IP address per hour.
RATE_LIMIT_UPLOADS_PER_HOUR=15

# Scans allowed per day: per guest, per signed-in user, and per IP address.
# Raise the guest limit locally if you scan often while developing.
RATE_LIMIT_SCANS_GUEST_PER_DAY=3
RATE_LIMIT_SCANS_USER_PER_DAY=20
RATE_LIMIT_SCANS_IP_PER_DAY=10

# MongoDB connection string. Local: run "npm run db:local" (or your own MongoDB) and use the
# value below. Production: a MongoDB Atlas "mongodb+srv://..." URI.
MONGODB_URI=mongodb://127.0.0.1:27017/atsly

# Secret for signing cookies, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Days before guest (no account) data is deleted.
GUEST_RETENTION_DAYS=7

# AI analysis. Without OPENAI_API_KEY a deterministic offline "mock" provider is used, so
# everything works locally without a key. Set AI_PROVIDER=off to disable AI entirely.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# Default model; compare models with "npm run eval:ai" before changing it.
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=25000
# Global daily AI spend cap in US dollars. Scans skip AI once it's reached.
AI_DAILY_BUDGET_USD=5
